  <value>1</value>
  <autosimplify>1</autosimplify>
  <feedbackstyle>1</feedbackstyle>
  <feedbackvariables>
    <text>iseq: equationp(ans1);
yleft: if iseq then is(lhs(ans1)=y) else false;
rt: if yleft then rhs(ans1) else 0;</text>
  </feedbackvariables>

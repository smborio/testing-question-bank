<?xml version="1.0" encoding="UTF-8"?>
<quiz>
<question type="stack">
<name>
<text>Equation line given two points ask find equation</text>
</name>
<questiontext format="html">
<text><![CDATA[<p>A line passes through the points \(A({@xa@}, {@ya@})\) and \(B({@xb@}, {@yb@})\).</p>
<p>Find the equation of the line, written in the form \(y=mx+c\). Give any fractions in your answer as fractions.</p>
<p>[[input:ans1]] [[validation:ans1]] [[feedback:prt_ans1]]</p>]]></text>
</questiontext>
<questionvariables>
<text>c: rand_with_prohib(-9, 9, [0]);
q: rand([2,3,4,5]);
plist: if q=2 then [1,3,5,7,9] elseif q=3 then [1,2,4,5,7,8] elseif q=4 then [1,3,5,7,9] else [1,2,3,4,6,7,8,9];
sg: rand([-1,1]);
p: sg*rand(plist);
a: rand(2)+1;
b: rand(2)+1;
m: p/q;
xa: -q*a;
xb: q*b;
ya: m*xa+c;
yb: m*xb+c;
ta1: y = m*x+c;
rhsT: m*x+c;
invT: (q/p)*x+c;
negT: -m*x+c;
swpT: c*x+p/q;</text>
</questionvariables>
<generalfeedback format="html">
<text><![CDATA[<p>The gradient is \(m=\frac{y_2-y_1}{x_2-x_1}=\frac{{@yb@}-({@ya@})}{{@xb@}-({@xa@})}={@m@}\).</p>
<p>Substitute \(A({@xa@},{@ya@})\) into \(y=mx+c\): \({@ya@}={@m@}\cdot({@xa@})+c\), so \(c={@c@}\).</p>
<p>The line is \({@ta1@}\).</p>]]></text>
</generalfeedback>
<specificfeedback format="html">
  <text></text>
</specificfeedback>
<questionnote format="moodle_auto_format">
<text>\(m={@m@}, c={@c@}, a={@a@}, b={@b@}\)</text>
</questionnote>
<penalty>0</penalty>
<input>
<name>ans1</name>
<type>algebraic</type>
<tans>ta1</tans>
<syntaxhint>y=</syntaxhint>
<boxsize>15</boxsize>
<forbidfloat>1</forbidfloat>
<strictsyntax>1</strictsyntax>
<insertstars>4</insertstars>
<syntaxattribute>0</syntaxattribute>
<forbidwords></forbidwords>
<allowwords></allowwords>
<requirelowestterms>0</requirelowestterms>
<checkanswertype>0</checkanswertype>
<mustverify>1</mustverify>
<showvalidation>1</showvalidation>
<options></options>
</input>

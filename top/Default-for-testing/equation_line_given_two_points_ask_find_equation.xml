<?xml version="1.0" encoding="UTF-8"?>
<quiz>
<question type="stack">
<name>
<text>Equation line given two points ask find equation</text>
</name>
<questiontext format="html">
<text><![CDATA[<p>A line passes through the points \(A({@xa@}, {@ya@})\) and \(B({@xb@}, {@yb@})\).</p>
<p>Find the equation of the line, written in the form \(y=mx+c\). Give any fractions in your answer as fractions.</p>
<p>[[input:ans1]] [[validation:ans1]] [[feedback:prt_ans1]]</p>]]></text>
</questiontext>
<questionvariables>
<text>q: rand([2,3,4,5]);
plist: if q=2 then [1,3,5] elseif q=3 then [1,2,4,5,7,8] elseif q=4 then [1,3,5,7,9,11] else [1,2,3,4,6,7,8,9,11,12,13,14];
sg: rand([-1,1]);
p: sg*rand(plist);
m: p/q;
xlist: sublist(makelist(i,i,-6,6), lambda([t], mod(t,q)#0));
xa: rand(xlist);
fl: floor(p*xa/q);
ya: fl+rand(11)-5;
k: rand([-2,-1,1,2]);
xb: xa+q*k;
yb: ya+p*k;
c: ya-m*xa;
ta1: y = m*x+c;</text>
</questionvariables>
<generalfeedback format="html">
<text><![CDATA[<p>Step 1: the gradient is \(m=\frac{y_2-y_1}{x_2-x_1}=\frac{{@yb@}-({@ya@})}{{@xb@}-({@xa@})}={@m@}\).</p>
<p>Step 2: substitute \(A({@xa@},{@ya@})\) into \(y=mx+c\): \({@ya@}={@m@}\cdot({@xa@})+c\).</p>
<p>Step 3: rearrange to \(c={@ev(ya-m*xa, simp=false)@}={@c@}\).</p>
<p>Step 4: the line is \(y={@m@}x[[if test="c>0"]]+{@c@}[[else]]{@c@}[[/if]]\).</p>]]></text>
</generalfeedback>
<specificfeedback format="html">
  <text></text>
</specificfeedback>
<questionnote format="moodle_auto_format">
<text>\(m={@m@}, c={@c@}, A=({@xa@},{@ya@}), B=({@xb@},{@yb@})\)</text>
</questionnote>
<penalty>0</penalty>
<input>
<name>ans1</name>
<type>algebraic</type>
<tans>ta1</tans>
<syntaxhint>y=</syntaxhint>
<boxsize>15</boxsize>
<forbidfloat>1</forbidfloat>
<strictsyntax>1</strictsyntax>
<insertstars>4</insertstars>
<mustverify>1</mustverify>
<showvalidation>1</showvalidation>
<syntaxattribute>0</syntaxattribute>
<forbidwords></forbidwords>
<allowwords></allowwords>
<requirelowestterms>0</requirelowestterms>
<checkanswertype>0</checkanswertype>
<options></options>
</input>
<prt>
  <name>prt_ans1</name>
  <value>1</value>
  <autosimplify>1</autosimplify>
  <feedbackstyle>1</feedbackstyle>
  <feedbackvariables>
    <text><![CDATA[iseq: equationp(ans1);
ex: if iseq then expand(lhs(ans1)-rhs(ans1)) else 0;
cy: if iseq then diff(ex,y) else 0;
lin: is(iseq and equal(diff(ex,x,2),0) and equal(diff(ex,y,2),0) and equal(diff(diff(ex,x),y),0) and cy#0);
ysol: if lin then -expand(ex-cy*y)/cy else 0;
corr: is(lin and algebraic_equivalence(ysol, m*x+c));
yleft: is(iseq and lhs(ans1)=y);
rr: if yleft then rhs(ans1) else 0;
tl: if not atom(rr) and op(rr)="+" then args(rr) else [rr];
xt: sublist(tl, lambda([t], not freeof(x,t)));
ct: sublist(tl, lambda([t], freeof(x,t)));
form: is(yleft and length(xt)=1 and length(ct)<=1 and freeof(x, ev(first(xt)/x,simp)));
gr: is(lin and algebraic_equivalence(diff(ysol,x), m));
pa: is(lin and algebraic_equivalence(subst(xa,x,ysol), ya));
pb: is(lin and algebraic_equivalence(subst(xb,x,ysol), yb));]]></text>
  </feedbackvariables>

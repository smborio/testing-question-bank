d: rand_with_prohib(-2,2,[0]);

/* Derived coefficients */
m: 2*c+a+d;
n: b-c^2-c*d;

/* Two branches of the function */
f_left: x^2+a*x+b;
f_right: m*x+n;

/* Teacher answers */

/* (a) One-sided limits */
ta1: c^2+a*c+b;
ta2: m*c+n;

/* (b) Function value */
ta3: m*c+n;

/* (c) One-sided derivatives */
ta4: 2*c+a;
ta5: m;


/* (d) Continuity and differentiability */
ta6: [
    [1, true, "continuous"],
    [0, false, "not continuous"]
];

ta7: [
    [1, false, "differentiable"],
    [0, true, "not differentiable"]
];

/* For general feedback */
f_left_deriv: diff(f_left,x);
]]></text>

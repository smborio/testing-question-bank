    <questionvariables>
      <text>start1:rand_with_step(1,500,1);
for i:1 while (integerp(start1/10)) do (start1:rand_with_step(1,500,1));
aa:float(start1/10)+50;

start2:rand_with_step(1,500,1);
for i:1 while (integerp(start2/10)) do (start2:rand_with_step(1,500,1));
bb:float(start2/10);

cc:float(rand_with_step(1,50,1)/100);

start4:rand_with_step(1,1000,1);
for i:1 while (integerp(start4/10)) do (start4:rand_with_step(1,1000,1));
dd:float(start4/10);

tans1:(aa-bb)/cc+sqrt(dd);
tans2:significantfigures(tans1,1);</text>

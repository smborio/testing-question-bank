    <name>
      <text>15.5 Simple quadratic inequality</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>Solve the following quadratic inequality.</p>
<p>\( {@quest@} >0\)</p>

<p>(a) Factorise the inequality.</p>
<p>[[input:ans5]] \( > 0 \) [[validation:ans5]] [[feedback:prt5]]</p>

<p>(b) Solve the inequality.</p>
<p> [[input:ans3]] or [[input:ans4]] [[validation:ans3]] [[validation:ans4]] [[feedback:prt2]] </p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text/>
    </generalfeedback>

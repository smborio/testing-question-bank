      <feedbackvariables>
        <text>/*Students get full credit for error carried forward from part (a)*/
ecf_ans3:(-1/grad)*(x-ans1)+ans2;

/*Students get partial credit for attempting to take the negative reciprocal of the gradient but forgetting to do both*/

    <questionvariables>
      <text>/* Point 1 (aa, bb) and Point 2 (cc, dd) */

aa:-rand(5)-2;
bb:rand(20)-10;
cc:aa+8;
dd:bb+16;

/* Part (a): Correct answers*/
t_ans1:(aa+cc)/2;
t_ans2:(bb+dd)/2;

/* Part (a): Incorrect answers for partial credit*/
pc_ans1_1:(aa-cc)/2;
pc_ans1_2:(cc-aa)/2;
pc_ans2_1:(bb-dd)/2;
pc_ans2_2:(dd-bb)/2;

/* Part (b): Correct answers*/
grad:(bb-dd)/(aa-cc);
t_ans3:expand((-1/grad)*(x-t_ans1)+t_ans2);
with_y:y=t_ans3;</text>

    <questionvariables>
      <text><![CDATA[/* Imagine a right angled triangle with right angle bottom right and a horizontal base */
/* With another triangle inside by adding a line from somewhere on the horizontal base to the top right vertex */

/* Generate the base length between 10 and 16 with 1d.p */
aa:rand(6)+10+(rand(9)+1)/10;

/* Generate the bottom left angle between 30 and 50 */
bb:rand(21)+30;
bb_for_graph:round(100*bb*pi/180)/100; 

/* Set distance from left of base to the point where it divides in two pieces */
zz_real:aa/2+(rand(30)-15)/10;

/* Find distance from right of base to the point where it divides in two pieces */
ww_real:aa-zz_real;

/* Find real height */
xx_real:aa*tan(bb*pi/180);

/* Generate length of middle hypotenuse cc*/
cc_real:sqrt(xx_real^2+ww_real^2);
cc:floor(10*float(cc_real))/10;

/* Find the exact values of the teacher answers with aa, bb and cc as generated */
xx:xx_real;
yy:asin(xx/cc)*180/pi;

xx_rounded:significantfigures(xx,3);
yy_from_rounded:asin(xx_rounded/cc)*180/pi;

/* Make sure randomisation leads to incorrect y answer if rounded x is used and all given lengths have 1 decimal */
/* --------------------NOTE---------------- */
/* The while loop did not work and needs further investigation. I generates 35 questions that satisfy the required conditions using the following question note: <p>cc</p><p>significantfigures(yy_from_rounded,3), significantfigures(yy,3), if significantfigures(yy_from_rounded,3)=significantfigures(yy,3) then "" else "different"  </p> */]]></text>

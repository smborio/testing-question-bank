    <questiontext format="html">
      <text><![CDATA[<p>The following digaram (not drawn to scale) shows triangles \(ABC\) and \(BCD\), where \(AB = {@float(aa)@}\) cm, \(CD = {@float(cc)@}\) cm and angle \(BAC = {@bb@}^{\circ}\).</p>
<p><centre>
[[jsxgraph width='600px' height='300px']]
var board = JXG.JSXGraph.initBoard(divid, {
  boundingbox: [-5, 20, 18, -5],
  axis: false,
  keepaspectratio: true,
  showNavigation: false,
  showCopyright: false
});

var p1 = board.create('point', [0, 0], { //bottom left point (at the origin)
  name: 'A',
  size: 0.1,
  fixed: true,
  visible: true,
  strokeColor:'#901B77',
  fillColor:'#901B77',
  label: {
    fontSize: 15,
    autoPosition: true,
    offset: [-10, -10]
  }
});

var hor_length = {#aa#}; //length of the base -- feed in variable name

var p2 = board.create('point', [p1.X() + hor_length, 0], { //bottom-right corner
  name: 'B',
  size: 0.1,
  fixed: true,
  visible: true,
  strokeColor:'#901B77',
  fillColor:'#901B77',
  label: {
    fontSize: 15,
    autoPosition: true,
    offset: [0, -10]
  }
});

var l1 = board.create('line', [p1, p2], { //base of triangle
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor:'#901B77',
});

var left_ang = {#bb_for_graph#}; //value of angle at bottom left  -- feed in variable name

// ----- line where hypotenuse is -------
var t = board.create('transform', [left_ang, p1], { //define a rotation from bottom left of given angle 
  type: 'rotate'
});
var p3 = board.create('point', [0.1, 0], { // dummy point to rotate
  name: '',
  visible: false
});
var p4 = board.create('point', [p3, t], { // rotated point
  name: '',
  visible: false
});
var l2 = board.create('line', [p1, p4], { // line fomring given abgle with base
  fixed: true,
  straightFirst: true,
  straightLast: true,
  strokeWidth: 2,
  visible: false
});

// ----- Vertical Height x -------
var p5 = board.create('point', [p2.X(), 0.1], { // dummy point above right of base
  name: '',
  visible: false
});
var l3 = board.create('line', [p2, p5], { // vertical line at right of base
  fixed: true,
  straightFirst: true,
  straightLast: true,
  strokeWidth: 2,
  visible: false
});
var p5 = board.create('intersection', [l2, l3, 0], { // Top right vertex
  name: 'C',
  size: 0.1,
  fixed: true,
  visible: true,
  strokeColor:'#901B77',
  fillColor:'#901B77',
  label: {
    fontSize: 15,
    autoPosition: true,
    offset: [0, 10]
  }
});
var l4 = board.create('line', [p2, p5], { //height of triangle
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor:'#901B77'
});

// ----- Outer Hypotenuse -------
var l4 = board.create('line', [p1, p5], { // Outer hypotenuse
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor:'#901B77'
});

// ----- Middle  Hypotenuse -------
var p6 = board.create('point', [p1.X()+{#zz_real#},0], { // point of middle hypotenuse on base
  name: 'D',
  size: 0.1,
  fixed: true,
  visible: true,
  strokeColor:'#901B77',
  fillColor:'#901B77',
  label: {
    fontSize: 15,
    autoPosition: true,
    offset: [-5, -10]
  }
});
var l4 = board.create('line', [p5, p6], { // middle hypotenuse
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor:'#901B77'
});

// ----- Labels -------
var an1 = board.create('angle', [p5, p2, p1], { //right angle
  name: '',
  radius: 1,
  label: {
    autoPosition: true,
    offset: [1000, 1000]
  }
});
var an2 = board.create('angle', [p2, p1, p5], { // bottom left angle sector
  radius: 2,
  label: {
    autoPosition: true,
    offset: [1000, 1000]
  }
});
var an3 = board.create('angle', [p2, p1, p5], { // bottom left angle label   -- feed in variable name: 
  radius: 2,
  name: {#bb#},
  label: {
    fontSize: 15,
    strokeColor:'#000000',
    autoPosition: true,
    offset: [0,-8]

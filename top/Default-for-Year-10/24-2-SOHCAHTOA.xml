});
var an5 = board.create('angle', [p2, p6, p5], { // y
  radius: 2,
  name: 'y',
  label: {
    fontSize: 15,
    strokeColor:'#000000',
    autoPosition: true,
    offset: [0,-8]
  }
});
var txt = board.create('text', [(p1.X()+p2.X())/2-2, -2, p2.X()], { // Length of base
  fontSize: 15,
  fixed: true
});
var txt = board.create('text', [(p6.X() + p5.X()) / 2, (p6.Y() + p5.Y()) / 2.5, {#cc#}], { // Length of middle hypotenuse   -- feed in variable name
  fontSize: 15,
  fixed: true
});
var txt = board.create('text', [p2.X() + 1 / 2.5, (p2.Y() + p5.Y()) / 2+1, 'x'], { // x
  fontSize: 15,
  fixed: true
});

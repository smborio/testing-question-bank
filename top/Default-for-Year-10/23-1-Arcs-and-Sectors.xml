<quiz>
  <question type="stack">
    <name>
      <text>23.1 Arcs and Sectors</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>The diagram below shows a sector with angle \({@aa@}^{\circ}\) and radius \({@rr@}\) cm. Find the area and perimeter of the sector. Give your answers to 3 significant figures.</p>

<p>[[jsxgraph]]
var board = JXG.JSXGraph.initBoard(divid, {
  boundingbox: [-1, 12, 12, -1],
  axis: false,
  keepaspectratio: true,
  showNavigation: false,
  showCopyright: false
});

// Angle of the sector
var sector_angle = {#float(aa_radians)#}; //feed in angle in radians

// centre of the sector
var p1 = board.create('point', [5, 5], {
  name: 'C',
  fixed: true,
  visible: false
});

// ----- Construct radii of sector -------
// point to the left of the centre CL
var p2 = board.create('point', [p1.X() - 5, p1.Y()], {
  name: 'CL',
  fixed: true,
  visible: false
});
// define a rotation of CL anticlockwise of half the sector angle
var t1 = board.create('transform', [sector_angle / 2, p1], {
  type: 'rotate'
});
// Construct Bottom Right Point BR
var p3 = board.create('point', [p2, t1], {
  name: 'BR',
  visible: false
});
// define a rotation of CL clockwise of half the sector angle
var t2 = board.create('transform', [-sector_angle / 2, p1], {
  type: 'rotate'
});
// Construct Bottom Right Point TR
var p4 = board.create('point', [p2, t2], {
  name: 'TR',
  visible: false
});
// bottom radius
var l1 = board.create('line', [p1, p3], {
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor: '#901B77',
});
// top radius
var l2 = board.create('line', [p1, p4], {
  fixed: true,
  straightFirst: false,
  straightLast: false,
  strokeWidth: 2,
  strokeColor: '#901B77',
});

// ----- Construct Arc -------
var c1 = board.create('arc', [p1, p4, p3], {
  strokeWidth: 2,
  strokeColor: '#901B77',
  visible: true
});

// ----- Labels -------
// Angle 
var anglea = board.create('angle', [p4, p1, p3], {
  radius: 0.75,
  name: {#aa#}, // feed here the value of angle in degrees
  label: {
    fontSize: 15,
    strokeColor: '#000000',
    autoPosition: true,
    offset: [-10, -10]
  }
});
// radius
var txt = board.create('text', [(p1.X() + p4.X()) / 2+0.5, (p1.Y() + p4.Y()) / 2 - 0.25, {#rr#}+' cm'], { // feed here the value of the radius
  fontSize: 15,
  fixed: true
});
[[/jsxgraph]]</p>


<p>Area = [[input:ans1]]cm\(^{2} \)[[validation:ans1]] [[feedback:prt1]]</p>
<p>Perimeter = [[input:ans2]]cm [[validation:ans2]] [[feedback:prt2]]</p>]]></text>

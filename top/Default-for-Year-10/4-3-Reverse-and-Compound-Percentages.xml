ee:bb*(1+cc/100)
ff:bb*(1+cc/100)*(1+dd/100)*(1+dd/100)
response2:decimalplaces(ee,2)
response3:decimalplaces(ff,2)
/* Just interest */
interest2:decimalplaces(response2-bb,2);
interest3:decimalplaces(response3-bb,2);</text>

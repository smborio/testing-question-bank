      <text>2018080600</text>
    </stackversion>
    <questionvariables>
      <text><![CDATA[aa1:rand([2,3,4]);
/*Make sure bb1 and cc1 are not the same */
bb1:rand([2,3,5,7]);
cc1:rand([2,3,5,7]);
for i:1 while (cardinality({bb1,cc1})<2) do (bb1:rand([2,3,5,7]),cc1:rand([2,3,5,7]));
expr1:aa1*bb1*p-aa1*cc1*p*q;
tans1:aa1*p*(bb1-cc1*q);
partial11:aa1*(bb1*p-cc1*q*p);
partial12:p*(aa1*bb1-aa1*cc1*q);

aa2:rand([4,5,6]);
bb2:rand([2,3,5,7]);
cc2:rand([2,3,5,7]);
/*Make sure bb2 and cc2 are not the same */
for i:1 while (cardinality({bb2,cc2})<2) do (bb2:rand([2,3,5,7]),cc2:rand([2,3,5,7]));
dd2:rand([3,4,5,6,7]);
ee2:rand([2,3,4]);
expr2:aa2*bb2*c^dd2*p^ee2+aa2*cc2*c*p^(ee2+1);
tans2:aa2*c*p^ee2*(bb2*c^(dd2-1)+cc2*p);
partial21:aa2*c*(bb2*c^(dd2-1)*p^ee2+cc2*p^(ee2+1));
partial22:aa2*p^ee2*(bb2*c^dd2+cc2*p*c);
partial23:c*p^ee2*(aa2*bb2*c^(dd2-1)+aa2*cc2*p);

aa3:rand([2,3,4,5]);
expr3:2*y^2-2*aa3^2;
tans3:2*(y+aa3)*(y-aa3);
partial31:2*(y^2-aa3^2);
partial32:(2*y+2*aa3)*(y-aa3);
partial33:(y+aa3)*(2*y-2*aa3);]]></text>
    </questionvariables>

ax:base^x;
by:base^y;

/*general solution*/
/*quest:base^(cc*x+dd*y+ee)*/
/*sol:(a^cc)*(b^dd)*base^ee*/

/*question 1*/
c1:rand(4)+2;
quest_1:ax^c1;
ta_1:a^c1;

/*question 2 */
c2:rand(4)+2;
d2:rand(4)+2;
quest_2:base^((c2*x)+(d2*y));
ta_2:(a^c2)*(b^d2);


/*question 3*/
c3:rand(4)+1;
quest_3:base^(x-y);
ta_3:a/b;



/*question 4*/
e4:rand(4)+1;
quest_4:base^(e4 - y);
ta_4:(base^e4)/b; 


/*question 5*/
c5:rand(5)+2;
e5:rand(4)+1;
quest_5:base^((c5*x)-e5);
ta_5:a^c5/base^e5;</text>

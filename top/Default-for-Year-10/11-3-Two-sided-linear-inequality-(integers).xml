    <questionvariables>
      <text><![CDATA[/* Part (a): pp <= n < qq */
pp:rand([-4,-3,-2,-1,0]);
qq:rand([pp+3,pp+4,pp+5]);

t_ans1:intersection({pp,pp+1,pp+2,pp+3,pp+4},{qq-1,qq-2,qq-3,qq-4,qq-5});


/* Part (b): aa <= bb*n + cc < dd */
bb:rand([2,3,4,5]);
cc:rand([-2,-1,1,2]);
ee:rand([1,2,3]);
ff:rand([2,3,4]);
gg:rand_with_step(1,bb-1,1);
aa:bb*ee+cc;
dd:bb*(ee+ff)+cc-gg;

t_ans2:intersection({ee,ee+1,ee+2,ee+3},{ee+ff-1,ee+ff-2,ee+ff-3,ee+ff-4});]]></text>
    </questionvariables>

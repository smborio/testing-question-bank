    <questionvariables>
      <text>/* Generating non-parallel vectors for (a) */
vector1_x:rand_with_prohib(-5,5,[0]);
vector1_y:rand_with_prohib(-5,5,[0,vector1_x]);
matrix1:matrix([vector1_x],[vector1_y]);

vector2_x:rand_with_prohib(-5,5,[0]);
vector2_y:rand_with_prohib(-5,5,[0,vector2_x, vector1_y*vector2_x/vector1_x]);
matrix2:matrix([vector2_x],[vector2_y]);

vectorAns_x:rand_with_prohib(-5,5,[0,vector1_x,-vector1_x]);
vectorAns_y:rand_with_prohib(-5,5,[0,vector2_y,-vector2_y,vectorAns_x]);
matrixAns:matrix([vectorAns_x],[vectorAns_y]);

aSol:(vector2_y*vectorAns_x-vector2_x*vectorAns_y)/(vector1_x*vector2_y-vector1_y*vector2_x);
bSol:(vector1_x*vectorAns_y-vector1_y*vectorAns_x)/(vector1_x*vector2_y-vector1_y*vector2_x);

/* Finding lowest x,y,z for (b) */
zSol:lcm(denom(aSol),denom(bSol));
xSol:aSol*zSol;
ySol:bSol*zSol;

/* Solving (c) and ensuring correct form. */

x_sqrFact: if integerp((vector1_x^2+vector1_y^2)/25) then 25 else if integerp((vector1_x^2+vector1_y^2)/16) then 16 else if integerp((vector1_x^2+vector1_y^2)/9) then 9 else if integerp((vector1_x^2+vector1_y^2)/4) then 4 else 1;
y_sqrFact: if integerp((vector2_x^2+vector2_y^2)/25) then 25 else if integerp((vector2_x^2+vector2_y^2)/16) then 16 else if integerp((vector2_x^2+vector2_y^2)/9) then 9 else if integerp((vector2_x^2+vector2_y^2)/4) then 4 else 1;
z_sqrFact: if integerp((vectorAns_x^2+vectorAns_y^2)/25) then 25 else if integerp((vectorAns_x^2+vectorAns_y^2)/16) then 16 else if integerp((vectorAns_x^2+vectorAns_y^2)/9) then 9 else if integerp((vectorAns_x^2+vectorAns_y^2)/4) then 4 else 1;

simp:false
c_xSol: if ev(sqrt((vector1_x^2+vector1_y^2)/x_sqrFact),simp)=1 then ev(abs(xSol*sqrt(x_sqrFact)),simp) else ev(abs(xSol*sqrt(x_sqrFact)),simp)*ev(sqrt((vector1_x^2+vector1_y^2)/x_sqrFact),simp);
c_ySol: if ev(sqrt((vector2_x^2+vector2_y^2)/y_sqrFact),simp)=1 then ev(abs(ySol*sqrt(y_sqrFact)),simp) else ev(abs(ySol*sqrt(y_sqrFact)),simp)*ev(sqrt((vector2_x^2+vector2_y^2)/y_sqrFact),simp);
c_zSol: if ev(sqrt((vectorAns_x^2+vectorAns_y^2)/z_sqrFact),simp)=1 then ev(abs(zSol*sqrt(z_sqrFact)),simp) else ev(abs(zSol*sqrt(z_sqrFact)),simp)*ev(sqrt((vectorAns_x^2+vectorAns_y^2)/z_sqrFact),simp);</text>
    </questionvariables>

    <questionvariables>
      <text>/* Random variables for part (a) */
aa:rand_with_prohib(2,11,[4,6,8,9,10]);
bb:rand_with_prohib(2,5,[4,aa]);
cc:rand_with_prohib(2,5,[4,aa,bb]);

num1:aa*bb*cc^2;
num2:aa*bb^2;

/* Answer part (a) */
t_ans1:aa*bb;

/* Random variables for part (b) */
/* Buzzer rings every 30/40/50 minutes */
rand1:rand([3,4,5])
time1:10*rand1;
/* Bell rings less frequently than the buzzer, every 70/80/90 minutes*/
rand2:rand_with_prohib(7,9,[rand1*2,rand1*3])
time2:10*rand2;
/* Sound together initially on any hour between 01.00 and 16.00 (so next ring together is always in the same day) */
time_init:rand(16)+1;

/* Answers part (b) */
lcm:lcm(time1,time2);
t_ans2:time_init+floor(lcm/60);
t_ans3:lcm-60*floor(lcm/60);</text>

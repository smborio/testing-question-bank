      <text>aa:rand_with_step(110,190,10);
bb:rand_with_step(10,90,10);
cc:decimalplaces(rand_with_step(7.1,7.9,0.1),1);
u_aa:aa+5;
l_aa:aa-5;
u_bb:bb+0.5;
l_bb:bb-0.5;
u_cc:decimalplaces(cc+0.05,2);
l_cc:decimalplaces(cc-0.05,2);
tans1:(l_aa-(u_bb))/(u_cc);
tans1_rd:decimalplaces(tans1,2);</text>

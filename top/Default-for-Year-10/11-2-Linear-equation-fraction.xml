      <text><![CDATA[aa:rand_with_prohib(-4,4,[0]);
bb:rand_with_prohib(-4,4,[0,2*aa,-2*aa,aa/2,-aa/2,aa,-aa]);
cc:rand_with_prohib(-4,4,[0,aa,-aa]);
dd:rand_with_prohib(-4,4,[0,2*cc,-2*cc,cc/2,-cc/2,cc,-cc]);
denominators: rand([[2,3],[3,5],[4,3],[4,5],[2,5]]);
p:denominators[1];
q:denominators[2];
x_sol:rand_with_prohib(-10,10,[0]); 

right:(aa*x_sol+bb)/p+(cc*x_sol+dd)/q;
while (abs(denom(right))>1 or right=0) do (aa:rand_with_prohib(-4,4,[0]),bb:rand_with_prohib(-4,4,[0,2*aa,-2*aa,aa/2,-aa/2,aa,-aa]),cc:rand_with_prohib(-4,4,[0,aa,-aa]),dd:rand_with_prohib(-4,4,[0,2*cc,-2*cc,cc/2,-cc/2,cc,-cc]),denominators: rand([[2,3],[3,5],[4,3],[4,5],[2,5]]),p:denominators[1],q:denominators[2],x_sol:rand_with_prohib(-10,10,[0]),right:(aa*x_sol+bb)/p+(cc*x_sol+dd)/q);

eqn:(aa*x+bb)/p+(cc*x+dd)/q=right;
eqn_no_denom_left:(aa*x+bb)*q+(cc*x+dd)*p;
eqn_no_denom_right:right*p*q;


/*-------------------------------------------------------------------------------------------*/
/*Define function S(n) that given a number n, returns the string "+n" if positive (or zero) and "-n" if negative, if n=+1 or -1 it returns + or - respectively*/
S(n):= block([], if (n=1) then return("+") elseif (n=-1) then return("-") elseif (n>=0) then return(vconcat("+", abs(n)))  else  return(vconcat("-", abs(n))));

/*Define function S1(n) that given a number n, returns the string "+n" if positive (or zero) and "-n" if negative (1 and -1 are treated as the other numbers)*/
S1(n):= block([], if (n>=0) then return(vconcat("+", abs(n)))  else  return(vconcat("-", abs(n))));

/*Define function SP(n) that given a number n, returns the string "n" if positive (or zero) and "(-n)" if negative*/
SP(n):= block([], if (n>=0) then return(n)  else  return(vconcat("(-", abs(n), ")")));

/*-------------------------------------------------------------------------------------------*/]]></text>

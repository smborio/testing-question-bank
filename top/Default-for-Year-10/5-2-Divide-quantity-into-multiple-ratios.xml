    <questionvariables>
      <text><![CDATA[aa:rand(7)+2;

bb_1:rand_with_prohib(2,4,[aa]);
bb_2:rand_with_prohib(2,7,[aa,bb_1]);

for i:1 while (gcd(aa,bb_1)>1 or gcd(aa,bb_1*bb_2)>1) do (aa:rand(7)+2,bb_1:rand_with_prohib(2,4,[aa]), bb_2:rand_with_prohib(2,7,[aa,bb_1]));

cf:rand([2,3,4]);
cc:cf*bb_1*bb_2;

/*model solutions*/
/*part a:ratio=aa:bb_1*bb_2*/
ta1:aa;
ta2:bb_1*bb_2;

/*part b*/
ta3:cc/(bb_1*bb_2)*aa;]]></text>
    </questionvariables>

    <questionvariables>
      <text><![CDATA[/* L: aa*y - bb*x = cc where -8 <= aa,bb <= 8 exc. -1,0,1 and 10 <= cc <= 40 such that the equation has not got common factors */

aa:rand_with_prohib(-8,8,[-1,0,1]);
bb:rand_with_prohib(-8,8,[-aa,-1,0,1,aa]);

lcm_ab:lcm(abs(aa),abs(bb));
cc:rand(30)+10;
while lcm_ab>1 and integerp(cc/lcm_ab) do (cc:rand(30)+10);

/* Point A: (dd,ee) for -8 <= dd,ee <= 8 exc. 0 */

dd:rand_with_prohib(-8,8,[0]);
ee:rand_with_prohib(-8,8,[0,dd,-dd]);

/* Point B: (ff, k) such that solving for kk gives and integer, so b/a must divide ff - dd */
gcd_ab:gcd(abs(aa),abs(bb));

diff_df:(abs(bb)/gcd_ab)*(rand(floor(10/(abs(bb)/gcd_ab)))+2)*rand([1,-1]);
ff:dd+diff_df;

/* Solutions */
Lgrad:bb/aa
Mgrad:-aa/bb
kk:ee-(aa*(ff-dd)/bb)]]></text>
    </questionvariables>

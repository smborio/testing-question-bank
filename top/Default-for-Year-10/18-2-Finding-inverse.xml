      <text>18.2 Finding inverse</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p> Find the inverse of g(x) given:</p>
<p> \( g(x)=\frac{{@num@}}{{@denome@}} \)</p>
<p>\( g^{-1} (x) = \) [[input:ans1]] [[validation:ans1]]</p>
[[feedback:prt1]]


/*Find \(g^{-1}\)(x)\).*/]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text/>
    </generalfeedback>

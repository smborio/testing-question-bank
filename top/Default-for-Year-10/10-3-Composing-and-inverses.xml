    <questionvariables>
      <text>/* Randomising equations */
fm:rand(5)+1;
fc:rand_with_prohib(-5,5,[0]);
ga:rand(3)+1
gc:rand_with_prohib(-5,5,[0]);

f(n) := block(return(fm*n+fc));
g(n) := block(return(ga*n^2+gc));

/* Randomising points of evaluation */

h1:rand(6)+1;
h2:-rand_with_prohib(1,6,[h1]);
k1:rand_with_prohib(1,6,[h1,-h2]);
k2:-rand_with_prohib(1,6,[h1,-h2,k1]);

/* Solutions */

tans1:f(g(h1));
tans2:f(g(h2));
tans3:g(f(k1));
tans4:g(f(k2));

tans5:sqrt((x-gc*fm-fc)/(ga*fm));
tans6:-sqrt((x-gc*fm-fc)/(ga*fm));

tans7:(-fc*ga+sqrt(ga*(x-gc)))/(ga*fm);
tans8:(-fc*ga-sqrt(ga*(x-gc)))/(ga*fm);</text>
    </questionvariables>

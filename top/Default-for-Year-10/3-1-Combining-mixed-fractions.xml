    <questionvariables>
      <text><![CDATA[/* Question part (a): "aa/bb + cc/dd" */

/* Generating the denominators */
/* Finding two different primes between 2 and 7, one for each denominator */
bb_fact:rand_with_prohib(2,7,[4,6]);
dd_fact:rand_with_prohib(2,7,[4,6,bb_fact]);
/* Finding a common prime between 2 and 5 for both denominators */
common_fact_qa:rand([2,3,5]);

/* Calculating the denominators */
bb:bb_fact*common_fact_qa;
dd:dd_fact*common_fact_qa;

/* Calculating numerators which are not multiples of bb/dd_fact or common_fact and which give fractions less than 1/2 */

aa: rand_with_prohib(1,floor(bb/2),[bb_fact,bb_fact*2,bb_fact*3,common_fact_qa,common_fact_qa*2]);
cc: rand_with_prohib(1,floor(dd/2),[dd_fact,dd_fact*2,dd_fact*3,common_fact_qa,common_fact_qa*2]);

/* Calculating teacher answer */
t_ans1:(aa*dd+bb*cc)/(bb*dd);


/* Question part (b): "uu vv/ww + xx yy/zz" */

/* Generating the mixed numbers */
/* Integer parts with uu > xx so that answer is more than 1 */
uu:rand(6)+2;
xx:rand_with_prohib(1,uu-1,[]);

/* Denominators with a common factor so that simplification is possible */
ww_fact:rand_with_prohib(2,5,[4]);
zz_fact:rand_with_prohib(2,5,[4,ww_fact]);
common_fact_qb:rand([2,3,5]);
ww:ww_fact*common_fact_qb;
zz:zz_fact*common_fact_qb;

/* Numerators less than relevant denominators and which cannot be reduced */
vv:rand_with_prohib(1,ww-1,factors(12*ww));
yy:rand_with_prohib(1,zz-1,factors(12*zz));

/* Calculating teacher answers */
qb_ans:((uu*ww+vv)*zz)/(ww*(xx*zz+yy));
t_ans2:floor(qb_ans)
t_ans3:qb_ans-t_ans2]]></text>
    </questionvariables>

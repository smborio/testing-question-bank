    <questionvariables>
      <text><![CDATA[/*part (1)-----------------------------------------------------*/
a1:rand_with_prohib(-6,6,[0,-1,1]);
b1:rand_with_prohib(-6,6,[0]);
c1:rand_with_prohib(-6,6,[0]);
expr1:a1*(b1*x+c1);
ta_1:expand(expr1);


/*part (2)----------------------------------------------------*/
a2:rand(6)+1;
b2:rand(6)+2;
c2:rand(6)+1;
/*want bc>a for considering always same possible mistakes*/
while (b2*c2<=a2) do c2:rand(6)+1;
d2:rand(6)+1;
expr2: a2*x-b2*(c2*x-d2);
ta_2:expand(expr2);

/*part (3) --------------------------------------------------------*/
a3:rand_with_prohib(-6,6,[0]);
b3:rand_with_prohib(-6,6,[0]);
c3:rand_with_prohib(-6,6,[0]);
d3:rand_with_prohib(-6,6,[0,b3,-b3]);
expr3:(a3*x+b3)*(c3*x+d3);
ta_3:expand(expr3);

/*part (4)-------------------------------------------------------------*/
a4:rand_with_prohib(-4,4,[0]);
b4:rand_with_prohib(-4,4,[0]);
c4:rand_with_prohib(-4,4,[0]);
d4:rand_with_prohib(-4,4,[0,b4,-b4]);
e4:rand_with_prohib(-4,4,[0]);
f4:rand_with_prohib(-4,4,[0,b4,-b4,d4,-d4]);
fac_1:a4*x+b4;
fac_2:c4*x+d4;
fac_3:e4*x+f4;

expr4:fac_1*fac_2*fac_3;
ta_4:expand(expr4);


/*--------------------------------------------------------------------------------------------*/
/*Define function S(n) that given a number n, returns the string "+n" if positive (or zero) and "-n" if negative, if n=+1 or -1 it returns + or - respectively*/

S(n):= block([], if (n=1) then return("+") elseif (n=-1) then return("-") elseif (n>=0) then return(vconcat("+", abs(n)))  else  return(vconcat("-", abs(n))));

/*Define function S1(n) that given a number n, returns the string "+n" if positive (or zero) and "-n" if negative (1 and -1 are treated as the other numbers)*/

S1(n):= block([], if (n>=0) then return(vconcat("+", abs(n)))  else  return(vconcat("-", abs(n))));

/*Define function SP(n) that given a number n, returns the string "n" if positive (or zero) and "(-n)" if negative*/

SP(n):= block([], if (n>=0) then return(n)  else  return(vconcat("(-", abs(n), ")")));

/*----------------------------------------------------------------------------------------------------*/]]></text>
